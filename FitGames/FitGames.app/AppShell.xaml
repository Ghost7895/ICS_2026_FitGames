<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FitGames.app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FitGames.app"
    xmlns:views="clr-namespace:FitGames.app.Views.Library"
    xmlns:gameViews="clr-namespace:FitGames.app.Views.Game"
    x:Name="AppShellRoot"
    FlyoutBehavior="Disabled"
    Title="FitGames.app">

    <Shell.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Home"
                            Command="{Binding Source={x:Reference AppShellRoot}, Path=GoToHomeCommand}" />
            <MenuFlyoutItem Text="Library"
                            Command="{Binding Source={x:Reference AppShellRoot}, Path=GoToLibraryCommand}" />
            <MenuFlyoutItem Text="Library"
                Command="{Binding GoToLibraryCommand}" />
        </MenuBarItem>
    </Shell.MenuBarItems>

    <TabBar>
        <Tab Route="home">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Route="library">
            <ShellContent ContentTemplate="{DataTemplate views:LibraryPage}" />
        </Tab>
    </TabBar><MenuFlyoutItem Text="Library"
                Command="{Binding GoToLibraryCommand}" />

</Shell>