<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.Home"
             xmlns:conv="clr-namespace:FitGames.app.Converters;assembly=FitGames.app"
             xmlns:bl="clr-namespace:FitGames.BL.Models;assembly=FitGames.BL"
             x:Class="FitGames.app.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="HomePageRoot"
             Title="Home">

    <views:ContentPageBase.Resources>
        <ResourceDictionary>
            <conv:ImageUrlToImageSourceConverter x:Key="ImageUrlConverter" />
            <conv:BoolToSortLabelConverter x:Key="BoolToSortLabelConverter" />
        </ResourceDictionary>
    </views:ContentPageBase.Resources>

    <Grid HorizontalOptions="Fill"
          RowDefinitions="Auto, Auto, Auto, *"
          RowSpacing="15">

        <Grid Grid.Row="0"
              Margin="20,20,20,0"
              ColumnDefinitions="*, Auto">
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="15"
                                   HorizontalOptions="Center">
                <Image Source="appicon.png"
                       WidthRequest="40"
                       HeightRequest="40"
                       VerticalOptions="Center" />
                <Label Text="FitGames"
                       FontSize="32"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.2"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label Text="⟳"
                       FontSize="28"
                       TextColor="{StaticResource Primary}"
                       Padding="8,4"/>
            </Border>
        </Grid>

        <!-- Search Bar a Filter Tlačidlo -->
        <Grid Grid.Row="1"
              Margin="20,0"
              ColumnDefinitions="*, Auto, Auto, Auto"
              ColumnSpacing="15"
              HeightRequest="45">
              
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=Black, Dark=White}"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    Padding="10,0">
                <Entry Placeholder="Search games..."
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center" />
            </Border>

            <!-- A→Z Sort Button -->
            <Border Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#1a1a1a}"
                    Stroke="{AppThemeBinding Light=Black, Dark=White}"
                    StrokeThickness="1"
                    Padding="12,0"
                    WidthRequest="75"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D0D0D0, Dark=#2a2a2a}" />
                                <Setter Property="Scale" Value="1.05" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label Text="{Binding SortAscending, Converter={StaticResource BoolToSortLabelConverter}}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Filter Button -->
            <Border Grid.Column="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                    Stroke="Transparent"
                    Padding="10"
                    WidthRequest="50"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.1" />
                                <Setter Property="Opacity" Value="0.85" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Image Source="filter.png" />
            </Border>

            <Border Grid.Column="3"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                    Stroke="Transparent"
                    WidthRequest="50"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAddGameCommand}" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.1" />
                                <Setter Property="Opacity" Value="0.85" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label Text="+"
           TextColor="{AppThemeBinding Light=Black, Dark=Black}"
           FontSize="20" FontAttributes="Bold"
           HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="2" Margin="20,0" VerticalOptions="Start" MaximumHeightRequest="400">
            <VerticalStackLayout
                IsVisible="{Binding IsAddGameVisible}" 
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" 
                Padding="15"
                Spacing="10"
                Margin="0,10">

                <Label Text="Add New Game" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="2">
                    <Label Text="Game Name:" FontSize="12" />
                    <Entry Text="{Binding AddNameInput, Mode=TwoWay}"
               Placeholder="Enter game title..." />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Description:" FontSize="12" />
                    <Entry Text="{Binding AddDescriptionInput, Mode=TwoWay}"
               Placeholder="Enter game description..." />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Developer Name:" FontSize="12" />
                    <Entry Text="{Binding AddDeveloperNameInput, Mode=TwoWay}"
               Placeholder="Enter developer company..." />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Cover Image URL:" FontSize="12" />
                    <Entry Text="{Binding AddImageUrlInput, Mode=TwoWay}" 
            Placeholder="https://example.com/image.png" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Select Genre:" FontSize="12" />
                    <Picker ItemsSource="{Binding AvailableGenres}" 
            SelectedItem="{Binding AddSelectedGenre}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Select PEGI Rating:" FontSize="12" />
                    <Picker ItemsSource="{Binding AvailablePegis}" 
            SelectedItem="{Binding AddSelectedPegi}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Border Grid.Column="0"
                BackgroundColor="Grey"
                WidthRequest="350"
                Stroke="Transparent"
                Padding="10"
                VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAddGameCommand}" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.1" />
                                        <Setter Property="Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="Cancel"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="13" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="1" 
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                Stroke="Transparent"
                WidthRequest="350"
                Padding="10"
                VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddNewGameCommand}" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.1" />
                                        <Setter Property="Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="Add New Game"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="13" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Filter Sekcia (Skrytá defaultne) -->
        <Border Grid.Row="2"
                Margin="20,0"
                IsVisible="{Binding IsFilterVisible}"
                Stroke="{AppThemeBinding Light=LightGray, Dark=DarkGray}"
                StrokeThickness="1"
                Padding="12"
                BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">
                <Label Text="Filter Options" FontAttributes="Bold" FontSize="15" />

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            StrokeThickness="1"
                            Padding="10,6"
                            HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#252525}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid RowDefinitions="Auto, Auto">
                            <Label Text="Genre" 
                                   FontSize="10" 
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#999999}"
                                   Grid.Row="0" />
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding SelectedGenre, TargetNullValue='All genres'}" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Label Text="▼" 
                                       Grid.Column="1" 
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#999999}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Picker ItemsSource="{Binding AvailableGenres}"
                                    SelectedItem="{Binding SelectedGenre}"
                                    Opacity="0"
                                    Grid.RowSpan="2" />
                        </Grid>
                    </Border>
                            
                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            StrokeThickness="1"
                            Padding="10,6"
                            HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#252525}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid RowDefinitions="Auto, Auto">
                            <Label Text="PEGI" 
                                   FontSize="10" 
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#999999}"
                                   Grid.Row="0" />
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding SelectedPegi, TargetNullValue='All ratings'}" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Label Text="▼" 
                                       Grid.Column="1" 
                                       FontSize="9"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#999999}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Picker ItemsSource="{Binding AvailablePegis}"
                                    SelectedItem="{Binding SelectedPegi}"
                                    Opacity="0"
                                    Grid.RowSpan="2" />
                        </Grid>
                    </Border>
                </Grid>

                <Border BackgroundColor="{AppThemeBinding Light=#C0C0C0, Dark=#1a1a1a}"
                        Stroke="Transparent"
                        Padding="16,6"
                        HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearFilterCommand}" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#A0A0A0, Dark=#2a2a2a}" />
                                    <Setter Property="Scale" Value="1.05" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label Text="Clear Filters"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           FontSize="13"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Dlazdicovy Zoznam Hier -->
        <CollectionView Grid.Row="3"
                        Margin="20,0,20,20"
                        HorizontalOptions="Fill"
                        ItemsSource="{Binding Games}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 VerticalItemSpacing="15"
                                 HorizontalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="bl:GameListModel">
                    <Border Padding="0"
                            Stroke="Transparent"
                            BackgroundColor="#E0E0E0"
                            HeightRequest="220">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.GoToDetailCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="DarkOverlay" Property="BoxView.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.05" />
                                        <Setter Property="Shadow">
                                            <Setter.Value>
                                                <Shadow Brush="Black" Opacity="0.5" Radius="15" Offset="0,5" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="DarkOverlay" Property="BoxView.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Image HorizontalOptions="Fill" VerticalOptions="Fill"
                                   Aspect="AspectFill"
                                   Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                   Opacity="0.9"
                                   x:Name="GameImage" />
                            <BoxView Opacity="0.3" Color="Black" x:Name="DarkOverlay" />
                            <VerticalStackLayout VerticalOptions="End" Margin="12,10">
                                <Label FontSize="14" LineBreakMode="WordWrap"
                                       Text="{Binding Name}"
                                       TextColor="White" FontAttributes="Bold" />
                                <Label FontSize="10"
                                       Text="{Binding Genre}"
                                       TextColor="LightGray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="No games found." FontSize="16" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</views:ContentPageBase>