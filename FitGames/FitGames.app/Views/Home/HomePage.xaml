<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.Home"
             xmlns:conv="clr-namespace:FitGames.app.Converters;assembly=FitGames.app"
             xmlns:bl="clr-namespace:FitGames.BL.Models;assembly=FitGames.BL"
             x:Class="FitGames.app.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="HomePageRoot"
             Title="Home">

    <views:ContentPageBase.Resources>
        <ResourceDictionary>
            <conv:ImageUrlToImageSourceConverter x:Key="ImageUrlConverter" />
            <conv:BoolToSortLabelConverter x:Key="BoolToSortLabelConverter" />
        </ResourceDictionary>
    </views:ContentPageBase.Resources>

    <Grid HorizontalOptions="Fill"
          RowDefinitions="Auto, Auto, Auto, *"
          RowSpacing="15">

        <HorizontalStackLayout Grid.Row="0"
                               Margin="20,20,20,0"
                               Spacing="15"
                               HorizontalOptions="Center">
            <Image Source="appicon.png"
                   WidthRequest="40"
                   HeightRequest="40"
                   VerticalOptions="Center" />
            <Label Text="FitGames"
                   FontSize="32"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Search Bar a Filter Tlačidlo -->
        <Grid Grid.Row="1"
              Margin="20,0"
              ColumnDefinitions="*, Auto, Auto"
              ColumnSpacing="15"
              HeightRequest="45">
              
            <Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=Black, Dark=White}"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    Padding="10,0">
                <Entry Placeholder="Search games..."
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center" />
            </Border>

            <!-- A→Z Sort Button -->
            <Border Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#1a1a1a}"
                    Stroke="{AppThemeBinding Light=Black, Dark=White}"
                    StrokeThickness="1"
                    Padding="12,0"
                    WidthRequest="75"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding SortAscending, Converter={StaticResource BoolToSortLabelConverter}}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Filter Button -->
            <Button Grid.Column="2"
                    ImageSource="filter.png"
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                    Command="{Binding ToggleFilterCommand}"
                    WidthRequest="50"
                    CornerRadius="8"
                    VerticalOptions="Fill" />
        </Grid>

        <!-- Filter Sekcia (Skrytá defaultne) -->
        <Border Grid.Row="2"
                Margin="20,0"
                IsVisible="{Binding IsFilterVisible}"
                Stroke="{AppThemeBinding Light=LightGray, Dark=DarkGray}"
                StrokeThickness="1"
                Padding="15"
                BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">
                <Label Text="Filter Options" FontAttributes="Bold" FontSize="16" />

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Picker Grid.Column="0" Title="Select Genre"
                            ItemsSource="{Binding AvailableGenres}"
                            SelectedItem="{Binding SelectedGenre}" />
                            
                    <Picker Grid.Column="1" Title="Select PEGI"
                            ItemsSource="{Binding AvailablePegis}"
                            SelectedItem="{Binding SelectedPegi}" />
                </Grid>

                <Button Text="Clear Filters"
                        Command="{Binding ClearFilterCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        HorizontalOptions="End"
                        Padding="20,8" />
            </VerticalStackLayout>
        </Border>

        <!-- Dlazdicovy Zoznam Hier -->
        <CollectionView Grid.Row="3"
                        Margin="20,0,20,20"
                        HorizontalOptions="Fill"
                        ItemsSource="{Binding Games}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 VerticalItemSpacing="15"
                                 HorizontalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="bl:GameListModel">
                    <Border Padding="0"
                            Stroke="Transparent"
                            BackgroundColor="#E0E0E0"
                            HeightRequest="220">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.GoToDetailCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <Grid>
                            <Image HorizontalOptions="Fill" VerticalOptions="Fill"
                                   Aspect="AspectFill"
                                   Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                   Opacity="0.9" />
                            <BoxView Opacity="0.3" Color="Black" />
                            <VerticalStackLayout VerticalOptions="End" Margin="12,10">
                                <Label FontSize="14" LineBreakMode="WordWrap"
                                       Text="{Binding Name}"
                                       TextColor="White" FontAttributes="Bold" />
                                <Label FontSize="10"
                                       Text="{Binding Genre}"
                                       TextColor="LightGray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="No games found." FontSize="16" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</views:ContentPageBase>