<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:conv="clr-namespace:FitGames.app.Converters;assembly=FitGames.app"
             xmlns:bl="clr-namespace:FitGames.BL.Models;assembly=FitGames.BL"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.Library"
             xmlns:enums="clr-namespace:FitGames.DAL.Enums;assembly=FitGames.DAL"
             x:Class="FitGames.app.Views.Library.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Library">
	<views:ContentPageBase.Resources>
		<ResourceDictionary>
			<conv:ImageUrlToImageSourceConverter x:Key="ImageUrlConverter" />
			<conv:BoolToSortLabelConverter x:Key="BoolToSortLabelConverter" />
			<conv:IsNotNullConverter x:Key="IsNotNullConverter" />

			<Style x:Key="FilterButtonStyle" TargetType="Border">
				<Setter Property="BackgroundColor" Value="#1a1a1a" />
				<Setter Property="Stroke" Value="#555" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="Padding" Value="14,8" />
				<Setter Property="StrokeShape">
					<Setter.Value>
						<RoundRectangle CornerRadius="6" />
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="DropdownItemStyle" TargetType="Border">
				<Setter Property="BackgroundColor" Value="#1e1e1e" />
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>
		</ResourceDictionary>
	</views:ContentPageBase.Resources>

	<!-- Root AbsoluteLayout so dropdowns can float over everything -->
	<AbsoluteLayout>

		<!-- Main content fills entire space -->
		<Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="Auto, Auto, *"
              Padding="20" RowSpacing="16">

			<Label Grid.Row="0"
			   Text="{Binding LibraryTitle}"
			   FontSize="28" FontAttributes="Bold"
			   HorizontalOptions="Center"
			   TextColor="White" />

			<!-- Search + Sort + PEGI row — fixed height, no expansion -->
			<Grid Grid.Row="1"
                  ColumnDefinitions="*, Auto, Auto"
                  ColumnSpacing="10"
                  HeightRequest="44">

				<Border Grid.Column="0"
                        BackgroundColor="#1a1a1a"
                        Stroke="#555" StrokeThickness="1"
                        Padding="12,0">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="6" />
					</Border.StrokeShape>
					<Entry Placeholder="Search games..."
                           PlaceholderColor="#888"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center"
                           Text="{Binding SearchText}" />
				</Border>

				<!-- A→Z -->
				<Border Grid.Column="1" Style="{StaticResource FilterButtonStyle}"
                        VerticalOptions="Center">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
					</Border.GestureRecognizers>
					<Label Text="{Binding SortAscending, Converter={StaticResource BoolToSortLabelConverter}}"
                           TextColor="White" FontSize="13" VerticalOptions="Center" />
				</Border>

				<!-- PEGI button only — dropdown is in AbsoluteLayout -->
				<Border Grid.Column="2" Style="{StaticResource FilterButtonStyle}"
                        WidthRequest="90" VerticalOptions="Center"
                        x:Name="PegiButton">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding TogglePegiDropdownCommand}" />
					</Border.GestureRecognizers>
					<HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
						<Label Text="{Binding PegiButtonLabel}"
                               TextColor="White" FontSize="13" VerticalOptions="Center" />
						<Label Text="▾" TextColor="#888" FontSize="11" VerticalOptions="Center" />
					</HorizontalStackLayout>
				</Border>
			</Grid>

			<!-- Genre button + Games -->
			<Grid Grid.Row="2" RowDefinitions="Auto, *" RowSpacing="12">

				<!-- Genre button only — dropdown is in AbsoluteLayout -->
				<Border Grid.Row="0" Style="{StaticResource FilterButtonStyle}"
                        WidthRequest="110" HorizontalOptions="Start"
                        x:Name="GenreButton">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ToggleGenreDropdownCommand}" />
					</Border.GestureRecognizers>
					<HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
						<Label Text="{Binding GenreButtonLabel}"
                               TextColor="White" FontSize="13" VerticalOptions="Center" />
						<Label Text="▾" TextColor="#888" FontSize="11" VerticalOptions="Center" />
					</HorizontalStackLayout>
				</Border>

				<ScrollView Grid.Row="1">
					<CollectionView ItemsSource="{Binding Games}">
						<CollectionView.ItemsLayout>
							<GridItemsLayout Orientation="Vertical" Span="3"
                                             VerticalItemSpacing="16" HorizontalItemSpacing="16" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="bl:GameListModel">
								<Border Padding="0" Stroke="Transparent"
                                        BackgroundColor="#1a1a1a" HeightRequest="160">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="8" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=GoToDetailCommand}"
                                            CommandParameter="{Binding Id}" />
									</Border.GestureRecognizers>
									<Grid>
										<Image HorizontalOptions="Fill" VerticalOptions="Fill"
                                               Aspect="AspectFill" Opacity="0.85"
                                               Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}" />
										<BoxView Opacity="0.35" Color="Black" />
										<Label Margin="10" FontSize="14" FontAttributes="Bold"
                                               LineBreakMode="WordWrap" Text="{Binding Name}"
                                               TextColor="White" VerticalOptions="End" />
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</ScrollView>
			</Grid>
		</Grid>

		<!-- PEGI dropdown — floats absolutely, never affects layout -->
		<Border IsVisible="{Binding IsPegiDropdownOpen}"
                BackgroundColor="#1e1e1e"
                Stroke="#555" StrokeThickness="1"
                AbsoluteLayout.LayoutBounds="0.99, 88, 90, AutoSize"
                AbsoluteLayout.LayoutFlags="XProportional">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="6" />
			</Border.StrokeShape>
			<VerticalStackLayout Spacing="0">
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Null}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="All" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Static enums:Pegi.Pegi3}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="3+" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Static enums:Pegi.Pegi7}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="7+" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Static enums:Pegi.Pegi12}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="12+" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Static enums:Pegi.Pegi16}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="16+" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetPegiFilterCommand}" CommandParameter="{x:Static enums:Pegi.Pegi18}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="18+" TextColor="White" FontSize="13" HorizontalOptions="Center" />
				</Border>
			</VerticalStackLayout>
		</Border>

		<!-- Genre dropdown — floats absolutely, never affects layout -->
		<Border IsVisible="{Binding IsGenreDropdownOpen}"
                BackgroundColor="#1e1e1e"
                Stroke="#555" StrokeThickness="1"
                AbsoluteLayout.LayoutBounds="20, 148, 140, AutoSize"
                AbsoluteLayout.LayoutFlags="None">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="6" />
			</Border.StrokeShape>
			<VerticalStackLayout Spacing="0">
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Null}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="All genres" TextColor="White" FontSize="13" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Static enums:Genre.Action}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="Action" TextColor="White" FontSize="13" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Static enums:Genre.RolePlaying}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="RPG" TextColor="White" FontSize="13" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Static enums:Genre.Adventure}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="Adventure" TextColor="White" FontSize="13" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Static enums:Genre.Sandbox}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="Sandbox" TextColor="White" FontSize="13" />
				</Border>
				<BoxView HeightRequest="1" Color="#333" />
				<Border Style="{StaticResource DropdownItemStyle}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SetGenreFilterCommand}" CommandParameter="{x:Static enums:Genre.Puzzle}" />
					</Border.GestureRecognizers>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroupList>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#1e1e1e" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Property="BackgroundColor" Value="#2a2a2a" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateGroupList>
					</VisualStateManager.VisualStateGroups>
					<Label Text="Puzzle" TextColor="White" FontSize="13" />
				</Border>
			</VerticalStackLayout>
		</Border>

	</AbsoluteLayout>
</views:ContentPageBase>