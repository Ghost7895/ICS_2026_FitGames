<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:conv="clr-namespace:FitGames.app.Converters;assembly=FitGames.app"
             xmlns:bl="clr-namespace:FitGames.BL.Models;assembly=FitGames.BL"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.Library"
             x:Class="FitGames.app.Views.Library.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Library">
	<views:ContentPageBase.Resources>
		<ResourceDictionary>
			<conv:ImageUrlToImageSourceConverter x:Key="ImageUrlConverter" />
		</ResourceDictionary>
	</views:ContentPageBase.Resources>

	<Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="20">

		<Label Grid.Row="0"
               Text="Your Library"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

		<Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
			<Border Grid.Column="0"
                    Stroke="{AppThemeBinding Light=Black, Dark=White}"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    Padding="10,0">
				<Entry Placeholder="Name..."
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center"
                       Text="{Binding SearchText}" />
			</Border>

			<ImageButton Grid.Column="1"
                         Source="dotnet_bot.png"
                         WidthRequest="30" HeightRequest="30"
                         VerticalOptions="Center" />

			<ImageButton Grid.Column="2"
                         Source="dotnet_bot.png"
                         WidthRequest="30" HeightRequest="30"
                         VerticalOptions="Center"
                         HorizontalOptions="End" />
		</Grid>

		<ScrollView Grid.Row="2">
			<CollectionView ItemsSource="{Binding Games}">
				<CollectionView.ItemsLayout>
					<GridItemsLayout Orientation="Vertical" Span="3"
                                     VerticalItemSpacing="20" HorizontalItemSpacing="20" />
				</CollectionView.ItemsLayout>

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="bl:GameListModel">
						<Border Padding="0"
                                Stroke="Transparent"
                                BackgroundColor="#E0E0E0"
                                HeightRequest="150">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10" />
							</Border.StrokeShape>

							<Border.GestureRecognizers>
								<TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=GoToDetailCommand}"
                                    CommandParameter="{Binding Id}" />
							</Border.GestureRecognizers>

							<Grid>
								<Image HorizontalOptions="Fill" VerticalOptions="Fill"
                                       Aspect="AspectFill"
                                       Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                       Opacity="0.9" />
								<BoxView Opacity="0.25" Color="Black" />
								<Label Margin="12"
                                       FontSize="16" LineBreakMode="WordWrap"
                                       Text="{Binding Name}"
                                       TextColor="White" VerticalOptions="End" />
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</ScrollView>

	</Grid>
</views:ContentPageBase>