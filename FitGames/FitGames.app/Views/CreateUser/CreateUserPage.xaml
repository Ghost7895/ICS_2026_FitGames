<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.CreateUser"
             x:Class="FitGames.app.Views.CreateUser.CreateUserPage"
             x:DataType="vm:CreateUserViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    <Grid>
        <ScrollView HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="450"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="30" Spacing="16">

                <Label Text="New Account"
                       Style="{StaticResource Headline}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1"
                         HorizontalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                <Label Text="Username *" Style="{StaticResource SubHeadline}" />
                <Entry Placeholder="e.g. gamer123"
                       Text="{Binding Username}" />

                <Label Text="Email *" Style="{StaticResource SubHeadline}" />
                <Entry Placeholder="e.g. user@email.com"
                       Text="{Binding Email}"
                       Keyboard="Email" />

                <Label Text="First Name" Style="{StaticResource SubHeadline}" />
                <Entry Placeholder="Optional"
                       Text="{Binding Name}" />

                <Label Text="Last Name" Style="{StaticResource SubHeadline}" />
                <Entry Placeholder="Optional"
                       Text="{Binding Surname}" />

                <Label Text="Phone Number" Style="{StaticResource SubHeadline}" />
                <Entry Placeholder="Optional"
                       Text="{Binding PhoneNumber}"
                       Keyboard="Telephone" />

                <Border BackgroundColor="{StaticResource Primary}"
                        Stroke="Transparent"
                        Padding="16,12"
                        Margin="0,16,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CreateUserCommand}" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1.03" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label Text="Create Account"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource White}"
                           FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="{StaticResource Primary}"
                        Stroke="Transparent"
                        Padding="16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1.03" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label Text="Cancel"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource White}"
                           FontAttributes="Bold" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</views:ContentPageBase>
