<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitGames.app.Views"
             xmlns:vm="clr-namespace:FitGames.app.ViewModels.SignIn"
             xmlns:models="clr-namespace:FitGames.BL.Models;assembly=FitGames.BL"
             x:Class="FitGames.app.Views.SignIn.SignInPage"
             x:DataType="vm:SignInViewModel"
             Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="Auto, *, Auto" Padding="30">

        <!-- Header  -->
        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="8">
            <Label Text="Fitgames"
                   Style="{StaticResource Headline}"
                   FontAttributes="Bold" />

            <Image Source="logo.png"
                   WidthRequest="160"
                   HeightRequest="160"
                   Aspect="AspectFill">
                <Image.Clip>
                    <RoundRectangleGeometry Rect="0,0,160,160" CornerRadius="24" />
                </Image.Clip>
            </Image>
        </VerticalStackLayout>

        <!-- Body -->
        <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center">

            <Label Text="Choose your account"
                   Style="{StaticResource SubHeadline}"
                   FontAttributes="Bold,Italic" />

            <BoxView HeightRequest="1"
                     HorizontalOptions="Fill"
                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

            <!-- User cards and "+" button -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <CollectionView ItemsSource="{Binding Users}"
                                HeightRequest="180"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserListModel">
                            <VerticalStackLayout Spacing="8" WidthRequest="120">
                                <Border WidthRequest="120" HeightRequest="120"
                                        BackgroundColor="{StaticResource Gray200}"
                                        Stroke="{StaticResource Gray300}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SignInViewModel}}, Path=SelectUserCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1.05" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Image Source="user.png" Aspect="AspectFit" Opacity="0.4" />
                                </Border>
                                <Label Text="{Binding Username}"
                                       HorizontalOptions="Center"
                                       FontSize="14" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add user button -->
                <Border BackgroundColor="{StaticResource Primary}"
                        Stroke="Transparent"
                        WidthRequest="60"
                        HeightRequest="60"
                        VerticalOptions="Start"
                        Margin="0,30,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddUserCommand}" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1.1" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label Text="+"
                           FontSize="32"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Grid>
</views:ContentPageBase>
