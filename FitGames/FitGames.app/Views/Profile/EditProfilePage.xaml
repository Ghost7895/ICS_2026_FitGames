<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FitGames.app.Views"
    xmlns:vm="clr-namespace:FitGames.app.ViewModels.Profile"
    x:Class="FitGames.app.Views.Profile.EditProfilePage"
    x:DataType="vm:EditProfileViewModel"
    x:Name="EditProfilePageRoot"
    Title="Edit Profile">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

        <!-- Header -->
        <Label 
            Text="Edit Your Profile" 
            FontSize="28" 
            FontAttributes="Bold" 
            HorizontalTextAlignment="Center"
            Margin="0,10,0,10"/>

        <!-- Info Message -->
        <Label
            Text="Update your name and phone number to keep your profile current"
            FontSize="14"
            TextColor="#999999"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,10"/>

        <!-- Form Section -->
        <Frame 
            BorderColor="#3B3B3B"
            Padding="15"
            BackgroundColor="#1E1E1E"
            CornerRadius="12"
            HasShadow="True">
            <VerticalStackLayout Spacing="15">

                <!-- Name Field -->
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="First Name" 
                        FontSize="14" 
                        FontAttributes="Bold"/>
                    <Entry 
                        Text="{Binding Name}"
                        Placeholder="Enter your first name"
                        PlaceholderColor="#666666"
                        FontSize="14"
                        Margin="0,0,0,0"
                        BackgroundColor="#2D2D2D"
                        TextColor="#FFFFFF"/>
                </VerticalStackLayout>

                <!-- Surname Field -->
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="Last Name" 
                        FontSize="14" 
                        FontAttributes="Bold"/>
                    <Entry 
                        Text="{Binding Surname}"
                        Placeholder="Enter your last name"
                        PlaceholderColor="#666666"
                        FontSize="14"
                        Margin="0,0,0,0"
                        BackgroundColor="#2D2D2D"
                        TextColor="#FFFFFF"/>
                </VerticalStackLayout>

                <!-- Email Field (Read-only) -->
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="Email (Cannot be changed)" 
                        FontSize="14" 
                        FontAttributes="Bold"/>
                    <Entry 
                        Text="{Binding Email}"
                        IsEnabled="False"
                        FontSize="14"
                        Margin="0,0,0,0"
                        BackgroundColor="#2D2D2D"
                        TextColor="#999999"/>
                </VerticalStackLayout>

                <!-- Phone Number Field -->
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="Phone Number" 
                        FontSize="14" 
                        FontAttributes="Bold"/>
                    <Entry 
                        Text="{Binding PhoneNumber}"
                        Placeholder="Enter your phone number"
                        PlaceholderColor="#666666"
                        FontSize="14"
                        Keyboard="Telephone"
                        Margin="0,0,0,0"
                        BackgroundColor="#2D2D2D"
                        TextColor="#FFFFFF"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <!-- Button Section -->
        <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
            <!-- Save Button -->
            <Border
                BackgroundColor="{StaticResource Primary}"
                Stroke="Transparent"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveProfileCommand}"/>
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
                                <Setter Property="Scale" Value="1.02"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label
                    Text="Save Changes"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Padding="15,15"/>
            </Border>

            <!-- Cancel Button -->
            <Border
                BackgroundColor="#3B3B3B"
                Stroke="Transparent"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#555555"/>
                                <Setter Property="Scale" Value="1.02"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label
                    Text="Cancel"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Padding="15,15"/>
            </Border>
        </VerticalStackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator 
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="{StaticResource Primary}"
            Scale="1.5"
            Margin="0,20,0,0"/>

    </VerticalStackLayout>
    </ScrollView>

</views:ContentPageBase>
