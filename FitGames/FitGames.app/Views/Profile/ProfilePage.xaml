<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FitGames.app.Views"
    xmlns:vm="clr-namespace:FitGames.app.ViewModels.Profile"
    xmlns:conv="clr-namespace:FitGames.app.Converters"
    x:Class="FitGames.app.Views.Profile.ProfilePage"
    x:DataType="vm:ProfileViewModel"
    x:Name="ProfilePageRoot"
    Title="Profile">

    <views:ContentPageBase.Resources>
        <ResourceDictionary>
            <conv:CountToWidthConverter x:Key="CountToWidthConverter" />
        </ResourceDictionary>
    </views:ContentPageBase.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Profile Header -->
            <Label 
                Text="Profile" 
                FontSize="32" 
                FontAttributes="Bold" 
                HorizontalTextAlignment="Center"
                Margin="0,20,0,0"/>

            <!-- Profile Card with User Info and Stats -->
            <Grid 
                ColumnDefinitions="Auto,*"
                ColumnSpacing="20"
                RowSpacing="15"
                Padding="15"
                RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- Profile Avatar -->
                <Frame 
                    Grid.Row="0" 
                    Grid.RowSpan="4"
                    Grid.Column="0"
                    CornerRadius="80"
                    BorderColor="Gray"
                    HasShadow="True"
                    Padding="0"
                    WidthRequest="160"
                    HeightRequest="160">
                    <Image 
                        Source="profile_avatar.png"
                        Aspect="AspectFill"
                        WidthRequest="160"
                        HeightRequest="160"/>
                </Frame>

                <!-- User Info Section -->
                <VerticalStackLayout 
                    Grid.Row="0" 
                    Grid.Column="1"
                    Spacing="5">
                    <Label 
                        Text="{Binding CurrentUser.Username, StringFormat='@{0}'}"
                        FontSize="18"
                        FontAttributes="Bold"/>
                    <Label 
                        Text="{Binding CurrentUser.Name, StringFormat='{0}'}"
                        FontSize="14"
                        Opacity="0.7"/>
                    <Label 
                        Text="{Binding CurrentUser.Email}"
                        FontSize="12"
                        Opacity="0.6"/>
                </VerticalStackLayout>

                <!-- Stats Grid -->
                <Grid 
                    Grid.Row="1" 
                    Grid.Column="1"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowSpacing="10">

                    <!-- Games Count -->
                    <Frame 
                        Grid.Column="0"
                        BorderColor="#3B3B3B"
                        Padding="12"
                        BackgroundColor="#1E1E1E"
                        CornerRadius="8">
                        <VerticalStackLayout Spacing="5">
                            <Label 
                                Text="{Binding TotalGames}"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource Primary}"/>
                            <Label 
                                Text="Games"
                                FontSize="12"
                                TextColor="#FFFFFF"
                                HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Favourite Genre -->
                    <Frame 
                        Grid.Column="1"
                        BorderColor="#3B3B3B"
                        Padding="12"
                        BackgroundColor="#1E1E1E"
                        CornerRadius="8">
                        <VerticalStackLayout Spacing="5">
                            <Label 
                                Text="{Binding FavouriteGenre}"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="#FF9500"
                                LineBreakMode="TailTruncation"/>
                            <Label 
                                Text="Favourite"
                                FontSize="12"
                                TextColor="#FFFFFF"
                                HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Edit Button -->
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Stroke="Transparent"
                    Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditProfileCommand}"/>
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
                                    <Setter Property="Scale" Value="1.03"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label
                        Text="Edit Profile"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Padding="20,12"/>
                </Border>

                </Grid>

            <!-- Genre Statistics Section -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                <Label 
                    Text="Genre Distribution" 
                    FontSize="18" 
                    FontAttributes="Bold"/>

                <CollectionView 
                    ItemsSource="{Binding GenreStatistics}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenreCountModel">
                            <VerticalStackLayout Padding="0,5">
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                                    <Label 
                                        Grid.Column="0"
                                        Text="{Binding Genre}"
                                        FontSize="12"
                                        WidthRequest="100"/>

                                    <StackLayout 
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <!-- Progress Bar representing count -->
                                        <BoxView 
                                            CornerRadius="4"
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="20"
                                            WidthRequest="{Binding Count, Converter={StaticResource CountToWidthConverter}}"/>
                                        <Label 
                                            Text="{Binding Count}"
                                            FontSize="12"
                                            VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Danger Zone - Delete Profile (small, bottom right) -->
            <HorizontalStackLayout HorizontalOptions="End" Margin="0,10,0,20">
                <Border
                    BackgroundColor="#C0392B"
                    Stroke="Transparent"
                    Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteProfileCommand}"/>
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#96281B"/>
                                    <Setter Property="Scale" Value="1.05"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Label
                        Text="🗑 Delete Profile"
                        TextColor="White"
                        FontSize="13"
                        Padding="14,8"/>
                </Border>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:ContentPageBase>
